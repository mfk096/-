# Скопируйте этот файл в frontend/.env.local и подставьте значения проекта.
# Supabase → Project Settings → API.
# Нужен anon public key. Ключ service_role сюда класть нельзя — ни в файл, ни в репозиторий.
# Пока переменные пустые или равны заглушкам ниже, приложение не падает:
# страница входа объясняет, что заполнить.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
