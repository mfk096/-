<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Сервер завода может быть без TLS. Камера от этого не зависит: сканер нативный. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
